# انسخي هالملف باسم .env واملأي القيم الحقيقية
# لا ترفعي ملف .env نفسه على Git أبداً (محطوط بالـ .gitignore)

# ---- قاعدة البيانات ----
DATABASE_URL=postgresql://clinic_user:your_password_here@localhost:5432/clinic_db

# ---- مفتاح توقيع جلسات الأدمن ----
# لازم قيمة عشوائية حقيقية — التوكنات بتتوقّع فيها، فبدونها أي حدا بيقدر
# يزوّر جلسة مديرة. ولّديها بهالأمر:
#   python -c "import secrets; print(secrets.token_hex(32))"
# التطبيق بيرفض يشتغل إذا كانت فاضية أو لسا القيمة القديمة dev-secret-change-me
SECRET_KEY=

# ---- المواقع المسموح لها تنادي الـ API من المتصفح ----
# مفصولة بفاصلة. إذا تركتيها فاضية بياخد localhost:3000 (التطوير المحلي).
# بالنشر: حطي دومين الموقع، مثلاً https://clinic.example.com
CORS_ORIGINS=

# ---- كلمات مرور الحسابات يلي بينشئها seed.py ----
# اختيارية: إذا تركتيها فاضية، السكربت بيولّد كلمة عشوائية وبيطبعها مرة وحدة.
SEED_ADMIN_PASSWORD=
SEED_RECEPTION_PASSWORD=

FLASK_ENV=development
